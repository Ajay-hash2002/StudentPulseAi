# Student Pulse AI - Environment Configuration Example
# Copy this file to .env and adjust values if needed.

# Database: SQLite default; can switch to PostgreSQL or MySQL
DATABASE_URL=sqlite:///./student_pulse.db

# Authentication Secret (JWT signing)
AUTH_SECRET=demo-secret-key-student-pulse-ai-2026-super-secure

# Access Token Lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Explainable AI Configuration (Optional)
# If AI_ENABLED is false or no key is provided, system falls back to deterministic template explanation
AI_ENABLED=false
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
